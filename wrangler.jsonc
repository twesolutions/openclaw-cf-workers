{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openclaw",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-10",
  "containers": [
    {
      "class_name": "OpenclawContainerV2",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 6000
      },
      "ssh": {
        "enabled": true
      },
      "authorized_keys": [
        {
          "name": "your-name",
          "public_key": "ssh-ed25519 AAAA... replace with your ~/.ssh/id_ed25519.pub"
        }
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "OpenclawContainerV2", "name": "OPENCLAW_CONTAINER" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["OpenclawContainerV2"], "tag": "v1" }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "R2_ACCOUNT_ID": "your-cloudflare-account-id",
    "R2_BUCKET_NAME": "openclaw-data"
  }
}
