{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openclaw",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-10",
  "containers": [
    {
      "class_name": "OpenclawContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
      "ssh": {
        "enabled": true
      },
      "authorized_keys": [
        {
          "name": "aaron",
          "public_key": "ssh-ed25519 AAAA...replace-with-your-public-key you@example.com"
        }
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "OpenclawContainer", "name": "OPENCLAW_CONTAINER" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["OpenclawContainer"], "tag": "v1" }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "R2_ACCOUNT_ID": "your-cloudflare-account-id",
    "R2_BUCKET_NAME": "openclaw-data"
  }
}
