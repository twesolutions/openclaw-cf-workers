{
  "name": "openclaw-cf-workers",
  "version": "1.0.0",
  "description": "Cloudflare Worker that runs the openclaw gateway in a Cloudflare Container, with R2-backed config persistence (via tigrisfs) and SSH access.",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev"
  },
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "cloudflare-containers",
    "durable-objects",
    "r2",
    "tigrisfs",
    "openclaw"
  ],
  "author": "Aaron Faby",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@cloudflare/containers": "^0.3.3",
    "@cloudflare/workers-types": "^4.20260510.1",
    "wrangler": "^4.90.0"
  }
}
